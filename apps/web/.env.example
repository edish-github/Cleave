# Where the web app reads data from.
#   sample  -> the built-in sample workspace (default, no backend needed)
#   api     -> the Cleave backend (not implemented yet; see src/services/README.md)
CLEAVE_DATA_SOURCE=sample

# Sample workspace only: simulated read latency in ms, so loading states are visible.
SAMPLE_LATENCY_MS=280

# Optional. When set, the landing page shows a "GitHub" link to this URL.
NEXT_PUBLIC_GITHUB_URL=

# Public URL of this deployment, used for share links on proof pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
