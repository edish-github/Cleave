# ---------------------------------------------------------------------------
# Cleave web app. Copy to .env.local for local development.
# With none of the live settings below, the app runs the labelled sample
# workspace only, which needs no backend.
# ---------------------------------------------------------------------------

# Public URL of this deployment (share links, proof URLs, push instructions).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, the landing page links to the repository.
NEXT_PUBLIC_GITHUB_URL=

# --- Live workspace --------------------------------------------------------
# Postgres. On Vercel, the Neon integration sets both of these.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app. Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Local development only --------------------------------------------------
# Sign in without GitHub (never works in production builds).
CLEAVE_DEV_LOGIN=
# Sample workspace read latency in ms, so loading states are visible.
SAMPLE_LATENCY_MS=280
